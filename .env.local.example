# ═══════════════════════════════════════════════════════════════════
# SANITY CMS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Sanity Studio Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Authentication Token
# Permisos requeridos: read, write, manage
SANITY_WRITE_TOKEN=

# Legacy naming (for backward compatibility with API calls)
SANITY_PROJECT_ID=
SANITY_DATASET=production

YOUTUBE_API_KEY=

# Page Revalidation (On-Demand ISR)
SANITY_REVALIDATION_TOKEN=your_revalidation_token_here

# Optional (recommended if you want to fetch drafts/preview content)
# SANITY_READ_TOKEN=

# API Configuration
SANITY_API_VERSION=2025-01-01
SANITY_USE_CDN=true

# Public site URL used by Sanity Studio to build upload links.
# Example: https://region-mayo.vercel.app
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile for community album photo uploads
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is public and safe in the browser.
# TURNSTILE_SECRET_KEY is private and must only exist on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Sheets for event registration exports
# Share the spreadsheet with the service account email.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Registros
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Product stock refresh (compatible with Vercel Hobby):
# Create a GET job at https://cron-job.org that runs every minute and calls
# https://YOUR_DOMAIN/api/cron/product-stock with this custom HTTP header:
# Authorization: Bearer YOUR_CRON_SECRET
# Set the same private value here and in the Vercel environment variables.
CRON_SECRET=

# ═══════════════════════════════════════════════════════════════════
# RECAPTCHA V3 CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
# 
# reCAPTCHA v3 es invisible para el usuario y se usa para detectar
# bots en el formulario del "Muro de Oraciones".
# 
# Cómo obtener tus keys:
# 1. Ve a: https://www.google.com/recaptcha/admin
# 2. Crea un nuevo sitio con reCAPTCHA v3
# 3. Copia las claves aquí
#
# - NEXT_PUBLIC_RECAPTCHA_SITE_KEY: Pública (segura en el cliente)
# - RECAPTCHA_SECRET_KEY: Privada (SOLO en servidor, nunca expongas)

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════
# META API CONFIGURATION (Instagram & Facebook)
# ═══════════════════════════════════════════════════════════════════
#
# Estos tokens se usan para obtener las últimas publicaciones de
# Instagram y Facebook. Si no están configurados, el sistema usará
# URLs de fallback guardadas en Sanity.
#
# Cómo obtener:
# 1. Ve a: https://developers.facebook.com/
# 2. Crea una aplicación (tipo "Business")
# 3. Agrega la "Graph API" app
# 4. Ve a Settings → Basic y copia el App ID y App Secret
# 5. Ve a Tools & Support → Graph API Explorer
# 6. Genera un token de acceso para tu página de Facebook/Instagram
#
# - META_APP_ID: ID de tu aplicación Meta
# - META_APP_SECRET: Secret de tu aplicación (SOLO en servidor)
# - META_PAGE_ACCESS_TOKEN: Token de acceso para tu página
# - META_INSTAGRAM_ACCOUNT_ID: ID de tu cuenta de Instagram Business
# - META_FACEBOOK_PAGE_ID: ID de tu página de Facebook

META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL: CACHING & PERFORMANCE
# ═══════════════════════════════════════════════════════════════════

# Redis URL (opcional, para rate-limiting distribuido)
# Si no está configurado, usamos un Map en memoria (solo development)
# REDIS_URL=redis://default:password@localhost:6379

# Frecuencia de actualización de cache de publicaciones (en horas)
SOCIAL_CACHE_REFRESH_HOURS=6
